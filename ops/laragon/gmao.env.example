# Modèle de configuration de l'API GMAO sur Laragon.
# Copier vers gmao\.env.laragon (fichier ignoré par git) puis remplacer chaque valeur <...>.
# Aucun secret ne doit être commité.

DJANGO_DEBUG=false
# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=<cle-secrete-longue-et-unique>
DJANGO_ALLOWED_HOSTS=gmao.test,localhost,127.0.0.1
FRONTEND_ORIGINS=https://gmao.test

# HTTPS est terminé par Nginx : il transmet X-Forwarded-Proto, Django le lit.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=3600

# Base MySQL locale (Laragon). Les noms AIVEN_* sont conservés pour ne pas changer le code.
GMAO_DATABASE_ENGINE=mysql
GMAO_MYSQL_SSL=false
AIVEN_MYSQL_HOST=127.0.0.1
AIVEN_MYSQL_PORT=3306
AIVEN_MYSQL_DATABASE=gmao
AIVEN_MYSQL_USER=gmao_app
AIVEN_MYSQL_PASSWORD=<mot-de-passe-mysql>

# Le contrôle des mots de passe compromis appelle un service en ligne : désactivé hors ligne.
GMAO_PWNED_PASSWORD_CHECK=false

# Jetons de supervision et de sauvegarde (même méthode que DJANGO_SECRET_KEY). Vide = fonction désactivée.
GMAO_HEALTH_TOKEN=<jeton-supervision>
GMAO_BACKUP_TOKEN=<jeton-sauvegarde>
