FRONTEND_ORIGINS=http://localhost:4200
DJANGO_SECRET_KEY=remplacer_par_une_valeur_longue_et_aleatoire
DJANGO_DEBUG=false
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600

# Base Aiven MySQL (ne jamais versionner les secrets réels)
GMAO_DATABASE_ENGINE=mysql
AIVEN_MYSQL_HOST=remplacer_par_hote_aiven
AIVEN_MYSQL_PORT=27355
AIVEN_MYSQL_DATABASE=defaultdb
AIVEN_MYSQL_USER=avnadmin
AIVEN_MYSQL_PASSWORD=remplacer_par_le_mot_de_passe_aiven
GMAO_PWNED_PASSWORD_CHECK=false
GMAO_PWNED_PASSWORD_TIMEOUT_SECONDS=3
AIVEN_MYSQL_SSL_MODE=REQUIRED
AIVEN_MYSQL_CA_PATH=.runtime/aiven-ca.pem
GMAO_LOCAL_TOKEN_MAX_AGE=43200
# Jeton de supervision distinct des sessions ; vide = diagnostic base inaccessible.
GMAO_HEALTH_TOKEN=
# Jeton dédié à la sauvegarde planifiée (GitHub Actions) ; vide = sauvegarde planifiée inaccessible.
GMAO_BACKUP_TOKEN=
