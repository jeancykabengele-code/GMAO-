{
  "name": "gmao-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:production": "node scripts/generate-environment.mjs && ng build --configuration production",
    "vercel-build": "npm run test:ci && npm run build:production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --reporters=junit --reporters=default --output-file=test-results/junit.xml",
    "test:csp": "node scripts/test-csp.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.8.1",
    "read-excel-file": "^9.3.10",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
